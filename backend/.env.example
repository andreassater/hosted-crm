# ---- Database ----
# Pooled connection used by the app at runtime.
#   Supabase: postgresql://postgres.[ref]:[pwd]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
#   Neon:     postgresql://[user]:[pwd]@[endpoint]-pooler.[region].neon.tech/[db]?sslmode=require
#   Railway:  postgresql://postgres:[pwd]@[host].railway.app:5432/railway
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hosted_crm?schema=public"

# Direct (non-pooled) connection, used ONLY for migrations. Required when DATABASE_URL
# points at a pooler (Supabase/Neon). Use the provider's :5432 direct string.
# Locally, set it equal to DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hosted_crm?schema=public"

# ---- Server ----
# Port the Express API listens on (5000 is used by macOS AirPlay Receiver).
# On Railway/Render this is injected automatically — do not hardcode it there.
PORT=5050

# Comma-separated list of allowed browser origins (production hardening).
# Leave unset to allow all origins (local dev). Example:
# CORS_ORIGIN="https://your-frontend.vercel.app"

# Set to "false" to skip auto-migrations in the container entrypoint
# (when you migrate via a separate release/pre-deploy step). Default: true.
# RUN_MIGRATIONS=true
