# PostgreSQL connection string.
# Get one from Supabase, Neon, or Railway, or run a local Postgres instance.
# Examples:
#   Local:    postgresql://postgres:postgres@localhost:5432/hosted_crm?schema=public
#   Supabase: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#   Neon:     postgresql://[user]:[password]@[endpoint].neon.tech/[db]?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hosted_crm?schema=public"

# Port the Express API listens on (5000 is used by macOS AirPlay Receiver)
PORT=5050
