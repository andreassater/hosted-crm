// Prisma schema for the Hosted CRM
// Docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  // Pooled connection used by the app at runtime (e.g. Supabase :6543 / Neon pooler).
  url      = env("DATABASE_URL")
  // Direct, non-pooled connection used only for migrations (e.g. Supabase/Neon :5432).
  // Locally this can be the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  LOST
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum SuggestionCategory {
  FEATURE
  IMPROVEMENT
  BUG
  OTHER
}

enum SuggestionStatus {
  NEW
  PLANNED
  DONE
  DECLINED
}

enum ActivityType {
  MEETING
  CALL
  EMAIL
  NOTE
  TASK
  OTHER
}

model Lead {
  id        String     @id @default(uuid())
  name      String
  company   String
  email     String     @unique
  phone     String?
  status    LeadStatus @default(NEW)
  value     Decimal    @default(0.0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  meetings  Meeting[]
  activities Activity[]
}

model KeyClient {
  id             String    @id @default(uuid())
  companyName    String    @unique
  primaryContact String
  email          String
  phone          String?
  tier           String    @default("Gold") // Gold, Platinum, Strategic
  annualRevenue  Decimal   @default(0.0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  meetings       Meeting[]
  activities     Activity[]
}

model Meeting {
  id          String        @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  status      MeetingStatus @default(SCHEDULED)
  leadId      String?
  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId    String?
  client      KeyClient?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// User-submitted tips for improving the app.
model Suggestion {
  id          String             @id @default(uuid())
  message     String
  category    SuggestionCategory @default(IMPROVEMENT)
  status      SuggestionStatus   @default(NEW)
  submittedBy String? // email of the submitter, set from the auth token
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// A logged interaction (call, email, note, …) attached to a Lead or KeyClient.
// Each activity may carry a single "next follow-up" that drives reminders.
model Activity {
  id         String       @id @default(uuid())
  type       ActivityType @default(NOTE)
  occurredAt DateTime     @default(now()) // when the activity happened
  note       String

  // Next follow-up (reminder). Optional — set followUpAt to schedule one.
  followUpAt     DateTime?
  followUpNote   String?
  followUpDone   Boolean   @default(false)
  followUpDoneAt DateTime?

  // Polymorphic link — attached to exactly one of a lead or a client (same as Meeting).
  leadId   String?
  lead     Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId String?
  client   KeyClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdBy String? // email, set from the auth token
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([followUpAt])
  @@index([leadId])
  @@index([clientId])
}
