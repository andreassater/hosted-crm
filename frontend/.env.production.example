# Frontend production env (set these in the Vercel project settings, not committed).
#
# Option A (recommended): use the vercel.json "/api" rewrite to proxy to the backend.
#   → leave VITE_API_URL UNSET. The app calls same-origin "/api/*"; no CORS needed.
#
# Option B: call the backend directly cross-origin.
#   → set the backend URL below AND set CORS_ORIGIN on the backend to this site's URL.
# VITE_API_URL="https://your-backend.up.railway.app"
