# Frontend env. Copy to .env.local for local dev, or set in Vercel for production.
# All VITE_* vars are embedded in the client bundle at build time (public).

# Backend API base. Leave UNSET to use same-origin "/api" (dev proxy or Vercel rewrite).
# VITE_API_URL="https://your-backend.up.railway.app"

# Supabase Auth. When BOTH are set, the app requires login. Leave unset for
# unauthenticated local review (matches backend AUTH_DISABLED=true).
# VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-anon-public-key"
