{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "//": "Proxy API calls to the backend so the browser stays same-origin (no CORS).",
      "source": "/api/:path*",
      "destination": "https://hosted-crm-api.onrender.com/api/:path*"
    },
    {
      "//": "SPA fallback: serve index.html for client-side routes (static assets are served first).",
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
